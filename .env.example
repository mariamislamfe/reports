NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Only used in server-side API routes (PDF generation, admin actions). Never exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_COMPANY_NAME="Your Company Name"
# Path under /public, or a full https:// URL.
NEXT_PUBLIC_COMPANY_LOGO_URL=/logo.png

# Optional: enables the "Translate to English" button on report text fields.
# Get a free key at https://www.deepl.com/pro-api (free tier: 500,000 chars/month).
# Server-only — never exposed to the client.
DEEPL_API_KEY=
